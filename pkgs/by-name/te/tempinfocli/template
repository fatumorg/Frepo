pkgname=tempinfocli
version=@pkgver@
revision=1
build_style=python3-pep517
hostmakedepends="python3-setuptools"
depends="python3-rich python3-psutil pciutils"
short_desc="A live terminal temperature dashboard"
maintainer="@maintainer@"
license="MIT"
homepage="https://github.com/fatumorg/TempInfoCLI"
distfiles="@url@"
checksum=@sha256@
wrksrc="@srcdir@"

post_install() {
	vlicense LICENSE
	vinstall packaging/linux/tempinfo.desktop 644 usr/share/applications
	vinstall assets/tempinfo.svg 644 usr/share/icons/hicolor/scalable/apps
	for size in 16 32 48 64 128 256; do
		vinstall assets/tempinfo-${size}.png 644 usr/share/icons/hicolor/${size}x${size}/apps tempinfo.png
	done
}
