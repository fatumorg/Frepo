pkgname=fatest
pkgver=@pkgver@
pkgrel=1
pkgdesc="A fast, clean terminal speedtest tool"
arch=('any')
url="https://github.com/naxce/fatest"
license=('MIT')
depends=('python' 'python-rich' 'speedtest-cli' 'python-psutil')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::@url@")
sha256sums=('@sha256@')

build() {
  cd "$srcdir/@srcdir@"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/@srcdir@"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/linux/fatest.desktop "$pkgdir/usr/share/applications/fatest.desktop"
  install -Dm644 assets/fatest-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/fatest.png"
}
